# =====================================================================
#  .env untuk Docker Compose. Salin:  cp .env.docker.example .env
#  Isi semua yang bertanda WAJIB sebelum `docker compose up`.
#
#  Nilai yang mengandung karakter $ (mis. password) WAJIB diapit kutip
#  tunggal, contoh: DB_PASSWORD='abc$123', agar tidak diproses Docker Compose.
# =====================================================================

APP_NAME="Contoh-CSIRT"
APP_ENV=production
APP_DEBUG=false
# WAJIB. Buat dengan:  echo "base64:$(openssl rand -base64 32)"
APP_KEY=
# WAJIB. Alamat publik situs (https).
APP_URL=https://csirt.contoh.go.id
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=Asia/Jakarta
LOG_LEVEL=warning

# Database (container "db"). WAJIB: password kuat & unik, mis. hasil `openssl rand -hex 24`.
DB_DATABASE=csirt
DB_USERNAME=csirt_app
DB_PASSWORD=
DB_ROOT_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=30
SESSION_ENCRYPT=true
# Set false HANYA untuk uji coba lokal tanpa HTTPS.
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Email hanya dipakai bila CSIRT_MAIL_NOTIFICATIONS=true (lihat bawah).
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@csirt.contoh.go.id"
MAIL_FROM_NAME="${APP_NAME}"

# Port Nginx di host. Default hanya 127.0.0.1 (di belakang reverse proxy TLS).
# Isi HTTP_BIND=0.0.0.0 bila ingin diakses langsung dari jaringan.
HTTP_BIND=127.0.0.1
HTTP_PORT=8080

# IP/CIDR yang boleh membuka halaman login. Sesuaikan dengan jaringan internal kantor/VPN.
# Catatan: tanpa reverse proxy (uji coba lokal), request dari host masuk dengan IP gateway
# Docker (172.x.x.x). Untuk uji coba saja, tambahkan 172.16.0.0/12. JANGAN dipakai di
# produksi di belakang reverse proxy kecuali set_real_ip_from sudah dikonfigurasi.
CSIRT_LOGIN_WHITELIST="127.0.0.1,::1"
CSIRT_ENFORCE_2FA=true
CSIRT_TICKET_PREFIX=CSIRT
CSIRT_ADVISORY_PREFIX=ADV
# Host tambahan yang diterima selain host APP_URL dan loopback (mis. alamat IP server).
CSIRT_TRUSTED_HOSTS=
# Alihkan 127.0.0.1/::1 ke host APP_URL (cookie sesi terikat ke nama host).
CSIRT_CANONICAL_REDIRECT=true
# Batas umur sesi dashboard sejak login (menit), terlepas dari aktivitas.
CSIRT_SESSION_ABSOLUTE_MINUTES=480
# Retensi data (hari), dijalankan harian oleh service "scheduler". 0 = nonaktif.
# Data pribadi aduan yang sudah ditutup lebih lama dari ini dianonimkan (UU PDP).
CSIRT_RETENTION_AUDIT_LOG_DAYS=730
CSIRT_RETENTION_CLOSED_TICKET_DAYS=0
# Notifikasi email aduan default nonaktif (aduan dikelola lewat dashboard).
# Untuk mengaktifkan: isi MAIL_* , set MAIL_MAILER=smtp dan CSIRT_MAIL_NOTIFICATIONS=true.
CSIRT_MAIL_NOTIFICATIONS=false
CSIRT_TEAM_EMAIL=
CSIRT_SECURITY_CONTACT=
CSIRT_SECURITY_POLICY_URL=

# Instalasi awal otomatis saat container pertama kali berjalan.
# Setelah superadmin terbuat, HAPUS ADMIN_PASSWORD dari file ini.
CSIRT_SITE_NAME="Contoh-CSIRT"
ADMIN_NAME="Administrator"
ADMIN_USERNAME=admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
