# =====================================================================
#  Konfigurasi Situs CSIRT — salin menjadi .env lalu sesuaikan.
#  Nilai default di bawah ini sudah aman untuk produksi.
# =====================================================================

APP_NAME="CSIRT"
APP_ENV=production
APP_KEY=
# Jangan pernah true di server produksi (membocorkan detail error & konfigurasi).
APP_DEBUG=false
# Wajib https:// di produksi.
APP_URL=https://csirt.contoh.go.id

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
APP_TIMEZONE=Asia/Jakarta

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=90
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Gunakan user database khusus (bukan root) dengan hak akses terbatas.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=csirt
DB_USERNAME=csirt_app
DB_PASSWORD=

# Sesi di database memungkinkan "logout dari perangkat lain".
SESSION_DRIVER=database
# Sesi berakhir setelah 30 menit tidak aktif.
SESSION_LIFETIME=30
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Wajib true bila diakses melalui HTTPS.
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@csirt.contoh.go.id"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------
#  Pengaturan khusus CSIRT (lihat config/csirt.php)
# ---------------------------------------------------------------------

# IP/CIDR yang boleh membuka halaman login (/csirt-login), pisahkan koma.
CSIRT_LOGIN_WHITELIST="127.0.0.1,::1"

# IP/CIDR reverse proxy yang dipercaya (Nginx/load balancer), mis. "172.16.0.0/12".
TRUSTED_PROXIES=

# Wajibkan 2FA untuk semua akun dashboard.
CSIRT_ENFORCE_2FA=true

# Prefix nomor tiket aduan & kode advisory.
CSIRT_TICKET_PREFIX=CSIRT
CSIRT_ADVISORY_PREFIX=ADV

# Email tim untuk notifikasi aduan baru (kosongkan untuk menonaktifkan).
CSIRT_TEAM_EMAIL=

# Batas ukuran tiap lampiran aduan (KB).
CSIRT_TICKET_MAX_KB=5120

# security.txt (RFC 9116). Kontak default diambil dari data Kontak di dashboard.
CSIRT_SECURITY_CONTACT=
CSIRT_SECURITY_POLICY_URL=
CSIRT_SECURITY_LANGUAGES="id, en"

# Content Security Policy
CSP_ENABLED=true
CSP_REPORT_URI=

# Dipakai oleh `php artisan csirt:install` dalam mode non-interaktif.
CSIRT_SITE_NAME=
ADMIN_NAME=
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

VITE_APP_NAME="${APP_NAME}"
